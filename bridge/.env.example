# Copy to .env (Bun loads it automatically).

# --- Agent Relay ---
# Workspace key (ar_ws_... from `npx agent-relay@next init --hosted`, or rk_live_...). If empty, a workspace named RELAY_WORKSPACE is created
# on first run and its key is saved to .relay-state.json.
RELAY_API_KEY=
RELAY_WORKSPACE=fde-council
# Optional. ar_ws_ keys use https://armadillo.agentrelay.com automatically.
RELAY_BASE_URL=
# Set to false to run debates without posting to Relay.
USE_RELAY=true

# --- Actors ---
# false = fake actors (no teammate-A code needed). true = the real actors in /actors.
USE_REAL_ACTORS=false
# Generated client. Default: ./generated/index.js, else ../actors/generated/index.js
# (made by `bunx durable-actors generate` while `bunx durable-actors dev` runs in /actors).
ACTORS_CLIENT=
# The generated client talks to the local actor server (127.0.0.1:7100) by default;
# DURABLE_ACTORS_CONTROL_PLANE_URL / _PROJECT_ID / _API_KEY / _SECRET override that.
# Pacing for the fake actors so the debate looks live (ms per turn).
FAKE_DELAY_MS=700

# --- HTTP ---
PORT=4000
