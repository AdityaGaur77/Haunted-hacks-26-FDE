# Copy to .env (Bun loads it automatically).

# --- Agent Relay ---
# Workspace key (rk_live_...). If empty, a workspace named RELAY_WORKSPACE is created
# on first run and its key is saved to .relay-state.json.
RELAY_API_KEY=
RELAY_WORKSPACE=fde-council
# Optional. Defaults to the hosted Relay (https://cast.agentrelay.com).
RELAY_BASE_URL=
# Set to false to run debates without posting to Relay.
USE_RELAY=true

# --- Actors ---
# false = fake actors (no teammate-A code needed). true = real Terse actors.
USE_REAL_ACTORS=false
# Generated Terse client (run `terse actor generate` in /actors). Path is relative to /bridge.
TERSE_CLIENT=../actors/generated/index.js
# Read by the generated client. Empty = local `terse actor dev` (http://127.0.0.1:7100/...).
TERSE_ACTOR_URL=
TERSE_API_KEY=
# Pacing for the fake actors so the debate looks live (ms per turn).
FAKE_DELAY_MS=700

# --- HTTP ---
PORT=4000
